# Copy to .env and fill in. Do not commit real secrets.

# live_paper = real odds, paper fills, real scores (production default)
# sim        = invented games (math test only)
# live       = same as live_paper until Kalshi execution is real
TRADING_MODE=live_paper

# Required for live_paper. Without it the worker skips the cycle (does not invent games).
ODDS_API_KEY=

# Win-only commission on profit. Losses are not charged.
FEE_PERCENTAGE=0.02

# Local SQLite when unset. Render sets the Postgres internal URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Daemon → API broadcasts
API_URL=http://127.0.0.1:5000

# live_paper cadence (15 minutes). Sim-only: PAPER_GAMES_PER_CYCLE
SCAN_INTERVAL_SECONDS=900
MAX_BETS_PER_CYCLE=10
LIVE_SPORTS=upcoming

# Sim only
PAPER_GAMES_PER_CYCLE=20
STARTING_BANKROLL=100

# Must stay false in production (worker runs the loop)
EMBED_DAEMON=false

# DISCORD_WEBHOOK_URL=

# Unused until Kalshi RSA signing is real
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY=
