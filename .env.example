# Copy to .env and fill in. Do not commit real secrets.

# live_paper = real odds, paper fills, real scores (default)
# sim        = invented games (math test only)
# live       = same as live_paper until Kalshi execution is real
TRADING_MODE=live_paper

# Win-only commission on profit (Kalshi-style). Losses are not charged.
FEE_PERCENTAGE=0.02

# Local SQLite is used when DATABASE_URL is unset.
# On Render this is the Postgres internal URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required for live odds. Without it, scanners fall back to mock markets
# and TRADING_MODE=live is forced back to paper.
# ODDS_API_KEY=

# How the daemon notifies the API (WebSockets). Local default is fine.
API_URL=http://127.0.0.1:5000

# Paper walk-forward size and cadence
PAPER_GAMES_PER_CYCLE=20
SCAN_INTERVAL_SECONDS=300
STARTING_BANKROLL=100

# On Render free web, run the daemon inside the API process
EMBED_DAEMON=false

# Optional alerts
# DISCORD_WEBHOOK_URL=

# Kalshi is still paper-only. These are unused until RSA signing is real.
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY=
